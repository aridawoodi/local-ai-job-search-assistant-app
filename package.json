{
  "name": "local-ai-job-search-assistant-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop Job Apply Assistant — Electron + Playwright + Ollama. Search, match, notify, and apply via a real browser on Mac and Windows.",
  "main": "out/main/index.js",
  "author": "Ari Dawoodi",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/package.mjs",
    "dist:mac": "node scripts/package.mjs --mac",
    "dist:win": "node scripts/package.mjs --win",
    "dist:dir": "node scripts/package.mjs --dir",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.aridawoodi.job.search.assistant",
    "productName": "Job Search Assistant",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "fixtures/**/*"
    ],
    "extraResources": [
      {
        "from": "fixtures",
        "to": "fixtures"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
